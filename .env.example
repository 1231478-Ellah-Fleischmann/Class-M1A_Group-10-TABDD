# Copiar para .env e preencher. Nunca fazer commit do .env.

# MySQL Server
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# MongoDB
MONGO_URI=
MONGO_DATABASE=

# Base de dados vetorial (Qdrant)
VECTOR_HOST=localhost
VECTOR_PORT=6333
VECTOR_API_KEY=
VECTOR_COLLECTION=pois

# Modelo de embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
