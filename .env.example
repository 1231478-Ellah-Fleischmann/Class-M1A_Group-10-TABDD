# Copiar para .env e preencher. Nunca fazer commit do .env.

# MySQL Server
MYSQL_HOST=vsgate-s1.dei.isep.ipp.pt
MYSQL_PORT=10238
MYSQL_USER=tourism_app
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_tourism

# MongoDB (preencher com a URI completa)
